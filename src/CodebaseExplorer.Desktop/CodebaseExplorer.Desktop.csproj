<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Composition root and Avalonia UI. Views contain no business logic (MVVM, see CLAUDE.md).
    ViewModels talk to the Application layer and Contracts DTOs only; the module project
    references below exist solely so that the composition root can register the modules.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CodebaseExplorer</AssemblyName>
    <RootNamespace>CodebaseExplorer.Desktop</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Windows: declares supported OS versions; required for native control hosting (WebView). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icon embedded in the executable (Explorer, desktop shortcuts). Generated by tools/icon/New-AppIcon.ps1. -->
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window icon (title bar, taskbar, Alt+Tab), loaded as avares://CodebaseExplorer/Assets/app-icon.ico. -->
    <AvaloniaResource Include="Assets\app-icon.ico" />
    <!-- App mark in the sidebar. -->
    <AvaloniaResource Include="Assets\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodebaseExplorer.Application\CodebaseExplorer.Application.csproj" />
    <ProjectReference Include="..\CodebaseExplorer.Contracts\CodebaseExplorer.Contracts.csproj" />
    <ProjectReference Include="..\CodebaseExplorer.Domain\CodebaseExplorer.Domain.csproj" />
    <ProjectReference Include="..\CodebaseExplorer.Infrastructure\CodebaseExplorer.Infrastructure.csproj" />
    <ProjectReference Include="..\CodebaseExplorer.Storage\CodebaseExplorer.Storage.csproj" />
    <ProjectReference Include="..\CodebaseExplorer.Analysis\CodebaseExplorer.Analysis.csproj" />
    <ProjectReference Include="..\CodebaseExplorer.Graph\CodebaseExplorer.Graph.csproj" />
    <ProjectReference Include="..\CodebaseExplorer.Git\CodebaseExplorer.Git.csproj" />
    <ProjectReference Include="..\CodebaseExplorer.AI\CodebaseExplorer.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <!-- Graph web view (GRAPH-003): built from src/CodebaseExplorer.GraphView.Web by `npm run build` and
         committed, so the .NET build needs no Node. Loaded from file:// by the graph host (GRAPH-004). -->
    <Content Include="GraphView/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- GC: collect and compact aggressively instead of growing the heap (decided in STORE-004). Saving a
         large model otherwise leaves hundreds of MB of uncollected batch garbage; with level 9 saving
         1,000,000 relationships peaks at ~1.3 GB instead of ~1.95 GB (TEST_STRATEGY.md §8). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>

</Project>
