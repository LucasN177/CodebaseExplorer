<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodebaseExplorer.Desktop.App"
             RequestedThemeVariant="Default">
  <!--
    Design system (UI modernization): Fluent theme with an indigo accent and neutral, layered surfaces.
    Tokens (brushes) are defined per theme variant below; styles refer to them with DynamicResource, so light/dark
    switching keeps working. Pages use the classes defined in Application.Styles instead of inline sizes/colors:
      TextBlock: pageTitle, pageSubtitle, sectionTitle, label, caption, muted, mono
      Border:    card, cardFlat, panel, banner, bannerError, badge, divider
      Button:    accent (Fluent), subtle, danger
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F5F8" />
          <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#EBEDF2" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7F8FA" />
          <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E1E4EA" />
          <SolidColorBrush x:Key="StrongBorderBrush" Color="#CDD2DB" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1D24" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6372" />
          <SolidColorBrush x:Key="TextTertiaryBrush" Color="#868E9C" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#3048C4" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#E7ECFF" />
          <SolidColorBrush x:Key="NavHoverBrush" Color="#E0E3EA" />
          <SolidColorBrush x:Key="NavSelectedBrush" Color="#DCE3FD" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#1D7F47" />
          <SolidColorBrush x:Key="WarningBrush" Color="#A55A06" />
          <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF4E5" />
          <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#EEF2FF" />
          <!-- Error surfaces (inline errors, notifications, startup error); the Fluent theme has no "critical" fills. -->
          <SolidColorBrush x:Key="ErrorBorderBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDE7E9" />
          <!-- Secondary buttons: white with a hairline instead of Fluent's grey fill. -->
          <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F2F4F8" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E7EAF0" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#CDD2DB" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#B8BFCB" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#B8BFCB" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#16181D" />
          <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1C1F25" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#20232A" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#262931" />
          <SolidColorBrush x:Key="SubtleBorderBrush" Color="#2E323B" />
          <SolidColorBrush x:Key="StrongBorderBrush" Color="#3B404B" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6E8EE" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3AAB7" />
          <SolidColorBrush x:Key="TextTertiaryBrush" Color="#727A88" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#9DB0FF" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#273058" />
          <SolidColorBrush x:Key="NavHoverBrush" Color="#262A33" />
          <SolidColorBrush x:Key="NavSelectedBrush" Color="#2A3150" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#5CC98C" />
          <SolidColorBrush x:Key="WarningBrush" Color="#F0B261" />
          <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#3A2D1A" />
          <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#222A45" />
          <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#442726" />
          <SolidColorBrush x:Key="ButtonBackground" Color="#2A2D35" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33373F" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#25282F" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3B404B" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#4A505C" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#4A505C" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
      <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#3B5BDB" RegionColor="#F4F5F8" />
        <ColorPaletteResources x:Key="Dark" Accent="#5B7CFA" RegionColor="#16181D" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <!-- Base -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Typography -->
    <Style Selector="TextBlock.pageTitle, SelectableTextBlock.pageTitle">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.pageSubtitle, SelectableTextBlock.pageSubtitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.caption, SelectableTextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.cardFlat">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.banner">
      <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.bannerWarning">
      <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.bannerError">
      <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>

    <!-- Controls -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
    </Style>
    <Style Selector="Button.subtle:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBorderBrush}" />
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown, AutoCompleteBox">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox, ComboBox, AutoCompleteBox">
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Application.Styles>
</Application>
