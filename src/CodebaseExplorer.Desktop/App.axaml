<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodebaseExplorer.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Error surfaces (inline errors, notifications, startup error). Defined here because the Fluent
           theme of Avalonia 12 provides no "critical" fill brushes; colors follow the Windows critical
           palette and keep text contrast in both theme variants. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ErrorBorderBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDE7E9" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#442726" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
