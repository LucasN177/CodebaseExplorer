<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodebaseExplorer.Desktop.ViewModels"
        x:Class="CodebaseExplorer.Desktop.Views.StartupErrorWindow"
        x:DataType="vm:StartupErrorViewModel"
        Title="Codebase Explorer — database error"
        Width="640" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="Codebase Explorer cannot start" FontSize="20" FontWeight="SemiBold" />
    <TextBlock TextWrapping="Wrap"
               Text="The local database could not be prepared. Your data has not been deleted or changed." />
    <Border BorderThickness="1" CornerRadius="6" Padding="12"
            BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
      <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </Border>
    <TextBlock Text="Database file" FontWeight="SemiBold" />
    <SelectableTextBlock Text="{Binding DatabaseFile}" TextWrapping="Wrap" Opacity="0.8" />
    <TextBlock Text="Backups taken before database updates" FontWeight="SemiBold" />
    <SelectableTextBlock Text="{Binding BackupDirectory}" TextWrapping="Wrap" Opacity="0.8" />
  </StackPanel>
</Window>
