<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:CodebaseExplorer.Desktop.ViewModels.Pages"
             x:Class="CodebaseExplorer.Desktop.Views.Pages.RunHistoryPageView"
             x:DataType="pages:RunHistoryPageViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.runs ListBoxItem">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ListBox.runs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="{Binding Title}" Classes="pageTitle" />
      <TextBlock Text="{Binding RepositoryName}" Classes="pageSubtitle" IsVisible="{Binding HasRepository}" />
      <Border Classes="bannerError" Margin="0,8,0,0" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" IsVisible="{Binding ShowEmptyState}" Classes="pageSubtitle"
               Text="Open or import a repository on the start page to see its analysis runs." />

    <Grid ColumnDefinitions="320,16,*" IsVisible="{Binding HasRepository}">
      <!-- Runs, newest first -->
      <Border Grid.Column="0" Classes="panel" Padding="6">
        <ListBox Classes="runs" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="pages:RunItemViewModel">
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <Border Classes="badge" IsVisible="{Binding IsCurrent}">
                    <TextBlock Text="current" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Classes="caption" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Details of the selected run -->
      <Border Grid.Column="2" Classes="panel" Padding="20" IsVisible="{Binding HasSelectedRun}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
            <TextBlock Text="{Binding SelectedRun.Title, FallbackValue=''}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedRun.Summary, FallbackValue=''}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedRun.Statistics, FallbackValue=''}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedRun.CommitText, FallbackValue=''}" Classes="caption mono" />
            <Border Classes="divider" Margin="0,8" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Diagnostics" Classes="sectionTitle" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" MinWidth="140" />
            </StackPanel>
            <TextBlock Text="{Binding DiagnosticsMessage}" Classes="muted"
                       IsVisible="{Binding DiagnosticsMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Diagnostics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pages:DiagnosticItemViewModel">
                  <Border BorderThickness="0,0,0,1" Padding="0,8" BorderBrush="{DynamicResource SubtleBorderBrush}">
                    <StackPanel Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding SeverityText}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ErrorBorderBrush}" IsVisible="{Binding IsError}" />
                        <TextBlock Text="{Binding SeverityText}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding !IsError}" />
                        <TextBlock Text="{Binding Code}" Classes="mono muted" VerticalAlignment="Center" />
                      </StackPanel>
                      <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                      <SelectableTextBlock Text="{Binding Origin}" Classes="caption mono" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
