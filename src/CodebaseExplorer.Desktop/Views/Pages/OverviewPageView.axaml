<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:CodebaseExplorer.Desktop.ViewModels.Pages"
             x:Class="CodebaseExplorer.Desktop.Views.Pages.OverviewPageView"
             x:DataType="pages:OverviewPageViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">
      <StackPanel Spacing="4" IsVisible="{Binding !HasOverview}">
        <TextBlock Text="{Binding Title}" Classes="pageTitle" />
        <TextBlock Classes="pageSubtitle" IsVisible="{Binding ShowEmptyState}"
                   Text="Open or import a repository on the start page to see its overview." />
      </StackPanel>
      <Border Classes="bannerError" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
      </Border>

      <StackPanel Spacing="16" IsVisible="{Binding HasOverview}">
        <!-- Header -->
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="accent" VerticalAlignment="Center"
                  Content="Open Architecture Explorer" Command="{Binding OpenExplorerCommand}" />
          <StackPanel Spacing="4" Margin="0,0,16,0">
            <TextBlock Text="Overview" Classes="label" />
            <TextBlock Text="{Binding Name}" Classes="pageTitle" TextTrimming="CharacterEllipsis" />
            <SelectableTextBlock Text="{Binding RootPath}" Classes="pageSubtitle" />
          </StackPanel>
        </DockPanel>

        <!-- Key figures -->
        <ItemsControl ItemsSource="{Binding Tiles}" Margin="-6,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pages:OverviewTile">
              <Border Classes="card" Padding="16,14" Margin="6,0">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Label}" Classes="label" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Value}" Classes="metric" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="banner" IsVisible="{Binding HasNoProjects}">
          <TextBlock TextWrapping="Wrap"
                     Text="No projects were recognized in this folder. Only file and language statistics are available; .NET, Node (package.json) and Python projects are detected." />
        </Border>

        <Grid ColumnDefinitions="3*,16,2*">
          <!-- Languages -->
          <Border Grid.Column="0" Classes="card" VerticalAlignment="Top">
            <StackPanel Spacing="12">
              <TextBlock Text="Languages" Classes="sectionTitle" />
              <ItemsControl ItemsSource="{Binding LanguageRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:LanguageRow">
                    <Grid ColumnDefinitions="120,*,90,110" Margin="0,4">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <ProgressBar Grid.Column="1" Value="{Binding Share}" Maximum="100" Height="6" MinHeight="6"
                                   CornerRadius="3" Margin="8,0,16,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Files}" Classes="muted" TextAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Lines}" Classes="muted" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="2" Spacing="16">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Projects by ecosystem" Classes="sectionTitle" />
                <ItemsControl ItemsSource="{Binding Ecosystems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" Margin="0,3" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No projects" Classes="muted" IsVisible="{Binding HasNoProjects}" />
                <TextBlock Text="{Binding MissingProjectsText}" Classes="caption"
                           IsVisible="{Binding MissingProjectsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Analysis" Classes="sectionTitle" />
                <TextBlock Text="{Binding ModelRunText}" TextWrapping="Wrap" />
                <Border Classes="bannerWarning" IsVisible="{Binding NewerRunText, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{Binding NewerRunText}" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
