<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:CodebaseExplorer.Desktop.ViewModels.Pages"
             x:Class="CodebaseExplorer.Desktop.Views.Pages.StartPageView"
             x:DataType="pages:StartPageViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.active">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="Welcome to Codebase Explorer" FontSize="28" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap" Opacity="0.8"
                 Text="Codebase Explorer analyzes software repositories locally and turns their structure and dependencies into an interactive architecture model. Repository code is only read, never executed." />

      <Button Content="Open local folder…" Margin="0,16,0,0"
              Command="{Binding OpenLocalFolderCommand}"
              Classes="accent" />
      <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                 Text="Currently .NET solutions and projects are recognized; other languages follow in later milestones." />
      <!-- Clone a remote repository (UI-008, WF-01); HTTPS only, token masked and held in memory only -->
      <Button Content="Clone remote repository…" Command="{Binding ShowCloneFormCommand}"
              IsVisible="{Binding !IsCloneFormOpen}" />
      <Border IsVisible="{Binding IsCloneFormOpen}"
              BorderThickness="1" CornerRadius="6" Padding="16"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="Clone a remote repository" FontWeight="SemiBold" />
          <TextBlock Text="HTTPS address (GitHub, GitLab or another Git host)" Opacity="0.8" FontSize="12" />
          <TextBox Text="{Binding CloneUrl}" PlaceholderText="https://github.com/owner/repository"
                   AutomationProperties.Name="Repository address" />
          <TextBlock Text="Branch (optional — default branch if empty)" Opacity="0.8" FontSize="12" />
          <TextBox Text="{Binding CloneBranch}" PlaceholderText="main" AutomationProperties.Name="Branch" />
          <TextBlock Text="Access token for private repositories (optional; kept in memory only, never stored)"
                     Opacity="0.8" FontSize="12" TextWrapping="Wrap" />
          <TextBox Text="{Binding CloneToken}" PasswordChar="•" RevealPassword="False"
                   AutomationProperties.Name="Access token" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Clone and analyze" Classes="accent" Command="{Binding CloneCommand}" />
            <Button Content="Close" Command="{Binding CloseCloneFormCommand}" />
          </StackPanel>
          <Border IsVisible="{Binding HasExistingClone}" BorderThickness="1" CornerRadius="6" Padding="12"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Spacing="8">
              <TextBlock TextWrapping="Wrap" Text="This repository was cloned before:" />
              <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Text="{Binding ExistingClonePath}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Update existing clone" Command="{Binding ResolveExistingCloneCommand}" CommandParameter="update"
                        ToolTip.Tip="Fetch the remote and check out the branch, then analyze" />
                <Button Content="Clone again" Command="{Binding ResolveExistingCloneCommand}" CommandParameter="reclone"
                        ToolTip.Tip="Delete the existing clone and clone it again, then analyze" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Progress panel (WF-01 step 4) -->
      <Border IsVisible="{Binding IsImporting}"
              BorderThickness="1" CornerRadius="6" Padding="16"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="Analyzing" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ImportPath}" TextWrapping="Wrap" Opacity="0.8" />
          <ItemsControl ItemsSource="{Binding Stages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pages:ImportStageViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                  <TextBlock Text="{Binding Glyph}" Width="16" TextAlignment="Center" />
                  <TextBlock Text="{Binding Name}" Classes.active="{Binding IsActive}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ProgressBar Minimum="0" Maximum="100"
                       Value="{Binding ProgressPercent}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding ProgressText}" Opacity="0.8" />
            <TextBlock Text="{Binding CurrentItem}" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="520" />
          </StackPanel>
          <Button Content="Cancel" Command="{Binding CancelImportCommand}" />
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Border IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
              BorderThickness="1" CornerRadius="6" Padding="12"
              BorderBrush="{DynamicResource ErrorBorderBrush}"
              Background="{DynamicResource ErrorBackgroundBrush}">
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
      </Border>

      <!-- Recent repositories (REPO-005, WF-01 step 1) -->
      <TextBlock Text="Recent repositories" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0"
                 IsVisible="{Binding HasRecentRepositories}" />
      <ItemsControl ItemsSource="{Binding RecentRepositories}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pages:RecentRepositoryItemViewModel">
            <Border BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
              <StackPanel Spacing="8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Open" IsEnabled="{Binding CanOpen}"
                            ToolTip.Tip="Show the stored analysis result without analyzing again"
                            Command="{Binding $parent[UserControl].((pages:StartPageViewModel)DataContext).OpenRecentCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="Re-analyze"
                            Command="{Binding $parent[UserControl].((pages:StartPageViewModel)DataContext).ReanalyzeCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="Remove"
                            Command="{Binding $parent[UserControl].((pages:StartPageViewModel)DataContext).RequestRemoveCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                  <StackPanel Spacing="2" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SourceText}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding RootPath}" />
                    <TextBlock Text="{Binding StatusText}" Opacity="0.7" FontSize="12" />
                  </StackPanel>
                </DockPanel>
                <Border IsVisible="{Binding IsConfirmingRemove}" BorderThickness="1" CornerRadius="6" Padding="12"
                        BorderBrush="{DynamicResource ErrorBorderBrush}"
                        Background="{DynamicResource ErrorBackgroundBrush}">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Content="Remove data"
                              Command="{Binding $parent[UserControl].((pages:StartPageViewModel)DataContext).ConfirmRemoveCommand}"
                              CommandParameter="{Binding}" />
                      <Button Content="Keep"
                              Command="{Binding $parent[UserControl].((pages:StartPageViewModel)DataContext).CancelRemoveCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                               Text="{Binding RemoveQuestion}" />
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
