<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:CodebaseExplorer.Desktop.ViewModels.Pages"
             xmlns:controls="using:CodebaseExplorer.Desktop.Controls"
             xmlns:graph="using:CodebaseExplorer.Contracts.Graph"
             x:Class="CodebaseExplorer.Desktop.Views.Pages.ArchitectureExplorerPageView"
             x:DataType="pages:ArchitectureExplorerPageViewModel">
  <UserControl.Styles>
    <!-- Evidence lines of a source snippet (UI-007); the color is not the only cue: the lines are also selected in the list. -->
    <!-- Inspector entries: flat, left-aligned, full width; a click shows the element in the graph (UI-006). -->
    <Style Selector="Button.inspector-item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.evidence">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Border.toolbar">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.toolbar TextBlock.toolLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.separator">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="4,6" />
      <Setter Property="Background" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>
    <Style Selector="TextBlock.inspectorSection">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Title}" Classes="pageTitle" />
        <TextBlock Text="{Binding RepositoryName}" Classes="pageSubtitle"
                   IsVisible="{Binding RepositoryName, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
      <Border Classes="toolbar" IsVisible="{Binding HasGraph}">
      <StackPanel Spacing="8">
      <DockPanel LastChildFill="False">
        <!-- Navigation: Back and the project level (GRAPH-009) -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
          <Button Content="‹ Back" Classes="subtle" Command="{Binding BackCommand}" ToolTip.Tip="Restore the previous view (expansions, filters, neighborhood)"
                  AutomationProperties.Name="Back" />
          <Button Content="⌂ Projects" Classes="subtle" Command="{Binding ShowTopLevelCommand}"
                  ToolTip.Tip="Back to the project level: collapse everything and leave the neighborhood (filters stay)"
                  AutomationProperties.Name="Back to the project level" />
        </StackPanel>
        <!-- Layout switcher (GRAPH-005); the choice is stored in the user settings -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <!-- Git-activity overlay (GIT-005): halo by file changes; off by default, not stored -->
          <!-- Git-activity overlay (GIT-005): halo by file changes; off by default, not stored -->
          <ToggleSwitch IsChecked="{Binding ShowActivity}" OnContent="Git activity" OffContent="Git activity"
                        AutomationProperties.Name="Show Git activity" />
          <Border Classes="separator" />
          <TextBlock Text="View" Classes="toolLabel" />
          <ComboBox ItemsSource="{Binding ViewModes}" SelectedItem="{Binding SelectedViewMode}" MinWidth="120"
                    AutomationProperties.Name="Graph view mode" ToolTip.Tip="Projects, or projects grouped by workspace, solution and ecosystem" />
          <TextBlock Text="Layout" Classes="toolLabel" />
          <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}" MinWidth="150"
                    AutomationProperties.Name="Graph layout" />
        </StackPanel>
      </DockPanel>
      <!-- Search (Ctrl/Cmd+K), filters and neighborhood view (GRAPH-007) -->
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
          <Button Content="Neighborhood" Command="{Binding ShowNeighborhoodCommand}"
                  ToolTip.Tip="Show the selected element with its dependencies only" />
          <ComboBox ItemsSource="{Binding DepthOptions}" SelectedItem="{Binding NeighborhoodDepth}" MinWidth="64"
                    AutomationProperties.Name="Neighborhood depth" ToolTip.Tip="Hops around the element" />
          <ComboBox ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding SelectedDirection}" MinWidth="150"
                    AutomationProperties.Name="Neighborhood direction" />
          <Button Content="Whole graph" Command="{Binding ShowWholeGraphCommand}" IsVisible="{Binding IsNeighborhood}" />
          <Button Content="Filters" AutomationProperties.Name="Graph filters">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ScrollViewer MaxHeight="480" Width="300">
                  <StackPanel Spacing="6" Margin="4">
                    <CheckBox Content="Test code" IsChecked="{Binding IncludeTests}" />
                    <CheckBox Content="Generated code" IsChecked="{Binding IncludeGenerated}" />
                    <CheckBox Content="External packages" IsChecked="{Binding IncludeExternalDependencies}" />
                    <TextBlock Text="Evidence" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <ComboBox ItemsSource="{Binding MinLevelOptions}" SelectedItem="{Binding SelectedMinLevel}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Minimum evidence level" />
                    <TextBlock Text="Languages (none = all)" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding LanguageFilters}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pages:FilterOption">
                          <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Ecosystems (none = all)" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding EcosystemFilters}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pages:FilterOption">
                          <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Relationships (none = all)" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding RelationshipKindFilters}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pages:FilterOption">
                          <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Reset filters" Command="{Binding ResetFiltersCommand}" Margin="0,6,0,0" />
                  </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
          <TextBlock Text="{Binding FilterSummary}" VerticalAlignment="Center" Opacity="0.7" FontSize="12"
                     IsVisible="{Binding FilterSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="Search projects, modules, types… (Ctrl+K)"
                 AutomationProperties.Name="Search" />
      </DockPanel>
      </StackPanel>
      </Border>
      <TextBlock Text="{Binding ActivityHint}" Classes="caption"
                 IsVisible="{Binding ActivityHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Border Classes="panel" Padding="6" IsVisible="{Binding SearchMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding SearchMessage}" Opacity="0.7" FontSize="12" />
          <ScrollViewer MaxHeight="240">
            <ItemsControl ItemsSource="{Binding SearchResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pages:SearchResultItem">
                  <Button Classes="inspector-item" ToolTip.Tip="Show its neighborhood"
                          Command="{Binding $parent[UserControl].((pages:ArchitectureExplorerPageViewModel)DataContext).OpenSearchResultCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detail}" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
      <!-- Breadcrumbs: the path to the focused element; a click focuses that step (the repository shows the whole graph) -->
      <ItemsControl ItemsSource="{Binding Breadcrumbs}" IsVisible="{Binding IsNeighborhood}" Margin="0,4,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="graph:BreadcrumbDto">
            <StackPanel Orientation="Horizontal">
              <Button Classes="inspector-item" Content="{Binding Label}"
                      Command="{Binding $parent[UserControl].((pages:ArchitectureExplorerPageViewModel)DataContext).OpenBreadcrumbCommand}"
                      CommandParameter="{Binding}" />
              <TextBlock Text="›" VerticalAlignment="Center" Opacity="0.5" Margin="2,0" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- Folder graph of a repository without projects (GRAPH-009) -->
      <Border Classes="banner" IsVisible="{Binding FolderHint, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding FolderHint}" TextWrapping="Wrap" FontSize="12" />
      </Border>
      <!-- Node budget (GRAPH-008): what was left out and how to see it -->
      <Border Classes="bannerWarning" IsVisible="{Binding TruncationText, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding TruncationText}" TextWrapping="Wrap" FontSize="12" />
      </Border>
      <Border Classes="bannerError" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <!-- Selection panel and Component Inspector (UI-006): node details, relationships, evidence and source (UI-007) -->
    <Border DockPanel.Dock="Right" Width="340" Margin="12,0,0,0" Padding="16" Classes="panel"
            IsVisible="{Binding HasGraph}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="8">
        <TextBlock Text="INSPECTOR" Classes="inspectorSection" Margin="0" />
        <TextBlock Text="Select a node or edge in the graph." Classes="muted" TextWrapping="Wrap"
                   IsVisible="{Binding !HasSelection}" />
        <StackPanel Spacing="4" IsVisible="{Binding HasSelection}">
          <TextBlock Text="{Binding SelectionName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Border Classes="badge" HorizontalAlignment="Left">
            <TextBlock Text="{Binding SelectionKind}" />
          </Border>
          <TextBlock Text="{Binding SelectionDetail}" Opacity="0.7" TextWrapping="Wrap"
                     IsVisible="{Binding SelectionDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding SelectionCountText}" Opacity="0.6" FontSize="12"
                     IsVisible="{Binding SelectionCountText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <!-- Component Inspector of a selected node (UI-006) -->
        <TextBlock Text="{Binding InspectorMessage}" Opacity="0.7" TextWrapping="Wrap" FontSize="12"
                   IsVisible="{Binding InspectorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Spacing="8" IsVisible="{Binding HasDetails}">
          <TextBlock Text="{Binding InspectorMetrics}" Classes="caption" />
          <StackPanel IsVisible="{Binding HasInspectorActivity}">
            <TextBlock Text="GIT ACTIVITY" Classes="inspectorSection" />
            <TextBlock Text="{Binding InspectorActivity}" TextWrapping="Wrap" FontSize="12" />
          </StackPanel>
          <!-- AI-008: explanation of the inspected element; model output is shown as plain text only. -->
          <StackPanel x:Name="ExplanationPanel" Spacing="6" DataContext="{Binding Explanation}" x:DataType="pages:ComponentExplanationViewModel"
                      IsVisible="{Binding $parent[UserControl].((pages:ArchitectureExplorerPageViewModel)DataContext).Explanation, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="✦ Explain with AI" Classes="accent" Command="{Binding ExplainCommand}" FontSize="12"
                      ToolTip.Tip="Generates an explanation from the analysis facts and source of this element (AI must be enabled in Settings)." />
              <Button Content="Regenerate" Command="{Binding RegenerateCommand}" FontSize="12" IsVisible="{Binding HasExplanation}" />
              <Button Content="Cancel" Command="{Binding CancelCommand}" FontSize="12" IsVisible="{Binding IsBusy}" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                       IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Panel IsVisible="{Binding HasExplanation}">
            <StackPanel Spacing="4" DataContext="{Binding Explanation}" x:DataType="pages:AiMessageItem">
              <TextBlock Text="AI-generated — check the citations" FontSize="11" Opacity="0.7" />
              <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding IsStreaming}" />
              <ItemsControl ItemsSource="{Binding Blocks}" IsVisible="{Binding IsComplete}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:MarkdownBlock">
                    <Panel Margin="0,2">
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding IsParagraph}" />
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding IsHeading}" />
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Margin="8,0,0,0" IsVisible="{Binding IsBullet}" />
                      <SelectableTextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" IsVisible="{Binding IsCode}" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding Meta}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Citations}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pages:AiCitationItem">
                    <Button Margin="0,0,4,4" FontSize="11" Content="{Binding Label}" ToolTip.Tip="{Binding ToolTip}"
                            Command="{Binding #ExplanationPanel.((pages:ComponentExplanationViewModel)DataContext).OpenCitationCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            </Panel>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding InspectorFacts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pages:InspectorFact">
                <StackPanel Margin="0,0,0,4">
                  <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Expander Header="Members" IsVisible="{Binding HasMembers}" HorizontalAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding InspectorMembers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pages:InspectorItem">
                  <Button Classes="inspector-item" Content="{Binding Label}" ToolTip.Tip="Show in graph"
                          IsEnabled="{Binding CanShowInGraph}"
                          Command="{Binding $parent[UserControl].((pages:ArchitectureExplorerPageViewModel)DataContext).ShowInGraphCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>

          <TextBlock Text="OUTGOING" Classes="inspectorSection" IsVisible="{Binding HasOutgoing}" />
          <ItemsControl ItemsSource="{Binding OutgoingGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pages:InspectorGroup">
                <Expander Header="{Binding Title}" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="pages:InspectorItem">
                        <Button Classes="inspector-item" ToolTip.Tip="Show in graph" IsEnabled="{Binding CanShowInGraph}"
                                Command="{Binding $parent[UserControl].((pages:ArchitectureExplorerPageViewModel)DataContext).ShowInGraphCommand}"
                                CommandParameter="{Binding}">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="INCOMING" Classes="inspectorSection" IsVisible="{Binding HasIncoming}" />
          <ItemsControl ItemsSource="{Binding IncomingGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pages:InspectorGroup">
                <Expander Header="{Binding Title}" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="pages:InspectorItem">
                        <Button Classes="inspector-item" ToolTip.Tip="Show in graph" IsEnabled="{Binding CanShowInGraph}"
                                Command="{Binding $parent[UserControl].((pages:ArchitectureExplorerPageViewModel)DataContext).ShowInGraphCommand}"
                                CommandParameter="{Binding}">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Evidence of the selected edge (GRAPH-010); select a record to see its source (UI-007) -->
        <TextBlock Text="EVIDENCE" Classes="inspectorSection"
                   IsVisible="{Binding HasEvidence}" />
        <ListBox MaxHeight="260" IsVisible="{Binding HasEvidence}" Background="Transparent"
                 ItemsSource="{Binding SelectionEvidence}" SelectedItem="{Binding SelectedEvidence}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="pages:EvidenceItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Location}"
                           Opacity="0.8" TextWrapping="Wrap" FontSize="12" />
                <TextBlock Text="{Binding Source}" Opacity="0.6" TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{Binding EvidenceMessage}" Opacity="0.7" TextWrapping="Wrap" FontSize="12"
                   IsVisible="{Binding EvidenceMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Source snippet of the selected evidence (UI-007): read-only plain text, evidence lines highlighted -->
        <StackPanel Spacing="6" Margin="0,8,0,0"
                    IsVisible="{Binding SnippetPath, Converter={x:Static ObjectConverters.IsNotNull}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Copy path" FontSize="12" Padding="8,2"
                    Command="{Binding CopyPathCommand}" />
            <Button DockPanel.Dock="Right" Content="Open in editor" FontSize="12" Padding="8,2" Margin="0,0,6,0"
                    Command="{Binding OpenInEditorCommand}" IsVisible="{Binding IsEditorConfigured}" />
            <TextBlock Text="{Binding SnippetPath}" FontWeight="SemiBold" FontSize="12"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding SnippetMessage}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{DynamicResource ErrorBorderBrush}"
                     IsVisible="{Binding SnippetMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto" IsVisible="{Binding HasSnippet}">
            <ItemsControl ItemsSource="{Binding SnippetLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pages:SnippetLine">
                  <Border Classes.evidence="{Binding IsEvidence}" Padding="2,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding NumberText}" Width="36" TextAlignment="Right" Opacity="0.5"
                                 FontFamily="{StaticResource MonoFontFamily}" FontSize="12" />
                      <SelectableTextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Classes="panel" ClipToBounds="True">
      <Grid>
        <controls:GraphHostControl Host="{Binding Graph}" IsVisible="{Binding HasGraph}" />
        <StackPanel IsVisible="{Binding ShowEmptyState}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="Architecture graph" Classes="sectionTitle" FontSize="18" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                     Text="No repository has been analyzed yet. Open a local folder on the Start page; its project graph is shown here." />
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
