<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CodebaseExplorer.Desktop.ViewModels"
        xmlns:pages="using:CodebaseExplorer.Desktop.ViewModels.Pages"
        xmlns:views="using:CodebaseExplorer.Desktop.Views.Pages"
        xmlns:services="using:CodebaseExplorer.Desktop.Services"
        xmlns:conv="using:CodebaseExplorer.Desktop.Converters"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="CodebaseExplorer.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Codebase Explorer"
        Icon="avares://CodebaseExplorer/Assets/app-icon.ico"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <!-- Explicit ViewModel-to-View mapping (no reflection-based view locator). -->
    <DataTemplate DataType="pages:StartPageViewModel">
      <views:StartPageView />
    </DataTemplate>
    <DataTemplate DataType="pages:OverviewPageViewModel">
      <views:OverviewPageView />
    </DataTemplate>
    <DataTemplate DataType="pages:ArchitectureExplorerPageViewModel">
      <views:ArchitectureExplorerPageView />
    </DataTemplate>
    <DataTemplate DataType="pages:AssistantPageViewModel">
      <views:AssistantPageView />
    </DataTemplate>
    <DataTemplate DataType="pages:RunHistoryPageViewModel">
      <views:RunHistoryPageView />
    </DataTemplate>
    <DataTemplate DataType="pages:ExportPageViewModel">
      <views:ExportPageView />
    </DataTemplate>
    <DataTemplate DataType="pages:SettingsPageViewModel">
      <views:SettingsPageView />
    </DataTemplate>
  </Window.DataTemplates>


  <Grid ColumnDefinitions="232,*" RowDefinitions="*,Auto">
    <!-- Sidebar: app mark, navigation, open repository -->
    <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,16,12,12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,0,20">
          <Image Source="avares://CodebaseExplorer/Assets/app-icon.png" Width="28" Height="28" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Codebase Explorer" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="Architecture analysis" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
          </StackPanel>
        </StackPanel>

        <!-- Open repository -->
        <Border DockPanel.Dock="Bottom" Classes="cardFlat" Padding="10,8" IsVisible="{Binding HasRepository}"
                ToolTip.Tip="{Binding RepositoryPath}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Data="{Binding Source=repository, Converter={x:Static conv:AppIcons.Converter}}" Width="16" Height="16"
                  Stretch="Uniform" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
            <StackPanel>
              <TextBlock Text="Open repository" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
              <TextBlock Text="{Binding RepositoryName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="160" />
            </StackPanel>
          </StackPanel>
        </Border>

        <ListBox Classes="nav" ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}"
                 AutomationProperties.Name="Navigation">
          <ListBox.Styles>
            <Style Selector="ListBox.nav">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="ListBox.nav ListBoxItem">
              <Setter Property="Padding" Value="10,8" />
              <Setter Property="Margin" Value="0,1" />
              <Setter Property="CornerRadius" Value="6" />
              <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            </Style>
            <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
            </Style>
            <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
            </Style>
            <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
            </Style>
            <Style Selector="ListBox.nav ListBoxItem:selected">
              <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="pages:PageViewModel">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{Binding IconKey, Converter={x:Static conv:AppIcons.Converter}}" Width="18" Height="18"
                      Stretch="Uniform" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                      Stroke="{Binding $parent[ListBoxItem].Foreground}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1" Grid.Row="0">
      <!-- Notification area (UI-001). Docked above the page, not overlaid: native controls such as the
           graph WebView would cover an overlay. -->
      <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Shell.Notifications}" Margin="28,12,28,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="services:ShellNotification">
            <Border Classes="bannerError" Margin="0,0,0,8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Classes="subtle" Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DismissNotificationCommand}"
                        CommandParameter="{Binding}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Current page -->
      <ContentControl Content="{Binding CurrentPage}" Margin="28,22,28,16" />
    </DockPanel>

    <!-- Status bar (UI-001): state of background operations -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="14,0" Height="28"
            Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding RepositoryPath}" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding !Shell.IsBusy}" VerticalAlignment="Center" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding Shell.IsBusy}"
                       Width="80" MinWidth="80" Height="3" MinHeight="3" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Shell.StatusText}" FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>