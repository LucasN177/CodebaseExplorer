# Normalize line endings: text files are stored with LF in the repository and
# checked out with the platform's native line endings.
* text=auto

# Files that must keep a specific line ending regardless of platform
*.sh    text eol=lf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Solution and project files
*.slnx  text
*.sln   text eol=crlf
*.csproj text
*.props text
*.targets text

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.dll   binary
*.exe   binary
*.db    binary
*.sqlite binary

# Fixture repositories are test input data: keep them byte-exact so that
# evidence line/column positions in EXPECTED.md stay stable on every platform.
tests/CodebaseExplorer.TestRepositories/Repositories/** -text
