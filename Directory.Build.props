<Project>
  <!--
    Shared build settings for every project in the repository.
    See docs/development/CODING_STANDARDS.md before changing anything here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comments. Public API docs are encouraged, not enforced. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>

    <Company>Codebase Explorer</Company>
    <Product>Codebase Explorer</Product>
    <Copyright>Copyright (c) Codebase Explorer contributors. All rights reserved.</Copyright>
  </PropertyGroup>
</Project>
